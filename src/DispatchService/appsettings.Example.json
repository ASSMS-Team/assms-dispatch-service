{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "default": "Server=localhost;Port=3306;Database=dispatchdb;User ID=<your-mysql-user>;Password=<your-mysql-password>;"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "CandidateMatching": {
    "RequiredSkillByServiceCategory": {
      "REPAIR": "AC"
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "assms-customer-asset-service",
      "Audience": "assms-internal",
      "SigningKey": "<a-secret-value-of-at-least-32-bytes>"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
