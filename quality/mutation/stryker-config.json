{
  "stryker-config": {
    "solution": "DispatchService.sln",
    "project": "DispatchService.csproj",
    "test-projects": [
      "tests/DispatchService.Tests/DispatchService.Tests.csproj"
    ],
    "reporters": [ "html", "json", "progress", "cleartext" ],
    "coverage-analysis": "perTest",
    "mutation-level": "Standard",
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "mutate": [
      "**/*.cs",
      "!**/Program.cs",
      "!**/Properties/AssemblyInfo.cs",
      "!**/Services/DispatchMigrationRunner.cs",
      "!**/Repositories/AutomaticAssignmentRepository.cs",
      "!**/Repositories/CandidateEvaluationRepository.cs",
      "!**/Repositories/TechnicianRepository.cs",
      "!**/Repositories/MySqlConnectionFactory.cs",
      "!**/Messaging/Publishers/KafkaJobAssignedPublisher.cs",
      "!**/Security/AuthorizeOperationFilter.cs",
      "!**/Controllers/HealthController.cs"
    ],
    "ignore-methods": [
      "*.LogTrace", "*.LogDebug", "*.LogInformation", "*.LogWarning", "*.LogError", "*.LogCritical"
    ]
  }
}
