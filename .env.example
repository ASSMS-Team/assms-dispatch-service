# Dispatch Service runtime values. Supply real values through the runtime secret mechanism.
ConnectionStrings__default=Server=<mysql-host>;Port=3306;Database=dispatchdb;User ID=<your-mysql-user>;Password=<your-mysql-password>;
Cors__AllowedOrigins__0=http://localhost:5173
# Must be identical in Customer & Asset, Dispatch, Job and Reporting.
Authentication__Jwt__Issuer=assms-customer-asset-service
Authentication__Jwt__Audience=assms-internal
Authentication__Jwt__SigningKey=<shared-jwt-signing-key-at-least-32-bytes>
# Optional: the JobCreated consumer and JobAssigned publisher only start when this is set.
Kafka__BootstrapServers=<kafka-host>:9092
# Every serviceCategory a job can carry needs a skill mapping, or Dispatch quarantines the event.
CandidateMatching__RequiredSkillByServiceCategory__INSTALLATION=AC_INSTALLATION
CandidateMatching__RequiredSkillByServiceCategory__REPAIR=AC
CandidateMatching__RequiredSkillByServiceCategory__MAINTENANCE=AC_MAINTENANCE
CandidateMatching__RequiredSkillByServiceCategory__INSPECTION=AC_INSPECTION
CandidateMatching__RequiredSkillByServiceCategory__WARRANTY_CLAIM=AC_WARRANTY
